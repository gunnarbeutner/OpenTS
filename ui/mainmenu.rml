<rml>
<!--
	The template carries its labels as literal control text rather than as string
	identifiers, so they stay literal here; a localized build ships a translated copy.
-->
<head>
	<link type="text/rcss" href="opents.rcss"/>
	<link type="text/rcss" href="menus.rcss"/>
	<style>
		/*
		 * The template is 204 by 147 dialog units at MS Sans Serif 8, which is 306 by 239
		 * logical pixels. The menu centred it across the frame and put its top 147 pixels
		 * down the 640 by 400 artwork.
		 */
		#menu
		{
			margin-left: -153dp;
			width: 306dp;
			height: 239dp;
			decorator: image(frame:306x239@167,147);
		}

		/*
		 * The buttons are 130 by 18 dialog units, which Resize_Dialog's extra pixel each way
		 * makes 195 by 30. The painter picked its skin by height, and 30 takes the tall set.
		 */
		#menu button
		{
			left: 56dp;
			width: 195dp;
			height: 30dp;
			line-height: 30dp;
			decorator: image(button:u:195x30);
		}

		#menu button:active:hover { decorator: image(button:d:195x30); }
		#menu button[disabled],
		#menu button[disabled]:active:hover { decorator: image(button:u:195x30); }

		#campaign { top: 20dp; }
		#load { top: 54dp; }
		#multiplayer { top: 88dp; }
		#intro { top: 122dp; }
		#options { top: 156dp; }
		#exit { top: 190dp; }
	</style>
</head>
<body>
	<div id="menu" class="dialog">
		<button id="campaign" data-action="campaign">New Campaign</button>
		<button id="load" data-action="load">Load Mission</button>
		<button id="multiplayer" data-action="multiplayer">Multiplayer Game</button>
		<button id="intro" data-action="intro">Intro / Sneak Peek</button>
		<button id="options" data-action="options">Options</button>
		<button id="exit" data-action="exit">Exit Game</button>
	</div>
</body>
</rml>

# Settings deploy.py reads. Copy to .env, which git ignores; the token is a
# credential and the rest are per-deployment, so none of it belongs in the tree.

# Where the stack runs, and where its compose file lives on that host.
OPENTS_DEPLOY_HOST="root@lobby.tf"
OPENTS_DEPLOY_DIR="/docker/sun"

# The origin the deployment is served as. Naming it is what makes a deploy end
# by dropping the old pointers from the edge; without it they are served until
# they expire, which is a day.
OPENTS_PUBLIC_URL="https://play-ts.net"

# A Cloudflare API token holding Zone.Cache Purge on the zone below, and that
# zone's id. Cache Purge alone cannot read the zone list, so the id is named
# rather than looked up.
CLOUDFLARE_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# The built asset tree to serve, if not ~/OpenTS-Assets/build/web.
#OPENTS_ASSETS=""

# Copy to .env and fill in. .env is not committed.
#
# The identity has to match a line from "security find-identity -v -p codesigning" exactly.
# A "Developer ID Application" certificate is the one Gatekeeper accepts off this machine;
# an "Apple Development" one signs only for the team's own devices.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarisation, without which Gatekeeper refuses a Developer ID bundle it has not seen.
# APPLE_PASSWORD is an app-specific password from appleid.apple.com, not the account one.
APPLE_ID=you@example.com
APPLE_PASSWORD=abcd-efgh-ijkl-mnop
APPLE_TEAM_ID=TEAMID

# A keychain profile keeps the password out of the process arguments, and is preferred
# over the three above when both are set. Create it once with:
#   xcrun notarytool store-credentials opents --apple-id … --team-id … --password …
# APPLE_KEYCHAIN_PROFILE=opents

# An App Store Connect API key works instead of either.
# APPLE_API_KEY=
# APPLE_API_ISSUER=
# APPLE_API_KEY_PATH=

# "./build.sh --appimage" ignores everything above and builds in a container. The platform
# sets the AppImage's architecture; an arm64 host has to build linux/arm64, since the
# emulated amd64 bundler cannot exec the AppImage tools.
# OPENTS_APPIMAGE_PLATFORM=linux/amd64
# OPENTS_APPIMAGE_IMAGE=opents-appimage

# Where a finished build is published for the browser page to offer, which
# tools/downloads/publish.py writes. Defaults to downloads/ at the repository root;
# --no-publish builds without touching it.
# OPENTS_DOWNLOADS=

# Compiled output
[Dd]ebug/
[Rr]elease/
/Run/*
!/Run/place_steam_build_here
*.obj
*.exe
*.dll
*.lib
*.res
*.ilk
*.map
*.exp

# MSVC intermediate files
*.aps
*.pdb
*.idb
*.pch

# CMake and Visual Studio 2022
[Bb]uild/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.sln
*.suo
*.user
*.vcxproj
*.vcxproj.*
.vs/

# Editors and language servers
*~
*.bak
*.swp
*.code-workspace
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/c_cpp_properties.clang.example.json
.history/
/.cache/
/.clangd
/compile_commands.json

# Python bytecode
__pycache__/
*.pyc

# Manual tooling temp snapshots (interrupted manage.py runs)
manual/data/.manual-check-*/
manual/data/.manual-generate-*/

# Agent worktrees, which are checkouts of this repository placed inside it
/.claude/worktrees/


# The engine-signing keys, provided per build and never committed: the private key reaches
# the image build as a secret, and the public key is baked from .sigkey.pub.
.sigkey*
*.sigkey
# Published native installers, which are build output and are never committed
/downloads/

# Signing and notarisation values for tauri/build.sh, which are per-developer secrets
# Deployment credentials: the Cloudflare purge token deploy.py reads.
/.env
/tauri/.env
